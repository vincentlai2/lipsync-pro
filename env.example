# -----------------------------------------------------------------------------
# Application Base URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="https://lipsync.pro"
NEXT_PUBLIC_WEBSITE_URL="https://lipsync.pro"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Better Auth
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""

# -----------------------------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Google OAuth
# Production redirect URI:
# https://lipsync.pro/api/auth/callback/google
# Local redirect URI:
# http://localhost:3001/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Email / Newsletter
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
BEEHIIV_API_KEY=""
BEEHIIV_PUBLICATION_ID=""

# -----------------------------------------------------------------------------
# Storage: Cloudflare R2 or S3-compatible storage
# -----------------------------------------------------------------------------
STORAGE_REGION="auto"
STORAGE_BUCKET_NAME=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_PUBLIC_URL=""

# -----------------------------------------------------------------------------
# Lip Sync AI generation
# Existing code keeps WAV2LIP_* names for compatibility with the current task
# pipeline. Product-facing copy should use Lip Sync AI / LipSync.pro.
# -----------------------------------------------------------------------------
ALIBABA_DASHSCOPE_API_KEY=""
DASHSCOPE_API_KEY=""
WAV2LIP_CREDITS_PER_TASK=20
WAV2LIP_MAX_VIDEO_FILE_SIZE=314572800
WAV2LIP_MAX_AUDIO_FILE_SIZE=31457280

# -----------------------------------------------------------------------------
# Stripe
# Create dedicated LipSync.pro products/prices. Default currency in config is USD.
# Webhook endpoint:
# https://lipsync.pro/api/webhooks/stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_BASIC_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_BASIC_YEARLY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=""
NEXT_PUBLIC_STRIPE_PRICE_ULTRA_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_ULTRA_YEARLY=""
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_BASIC=""
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_STANDARD=""
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_PREMIUM=""
NEXT_PUBLIC_STRIPE_PRICE_CREDITS_ENTERPRISE=""

# -----------------------------------------------------------------------------
# Runtime flags
# -----------------------------------------------------------------------------
DISABLE_IMAGE_OPTIMIZATION=false
NEXT_PUBLIC_DEMO_WEBSITE=false

